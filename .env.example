# Copy to .env and adjust. Never commit .env.

# development | testing | production
APP_ENV=development
# Lets `flask ...` CLI commands (db migrations, seed) find the app when run from backend/
FLASK_APP=run.py
LOG_LEVEL=INFO

# Must be a long random string in production (app refuses to start with the default).
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Origin allowed by CORS (Vite dev server by default)
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (used by docker-compose to create the database)
POSTGRES_USER=fintwin
POSTGRES_PASSWORD=fintwin
POSTGRES_DB=fintwin
POSTGRES_PORT=5432

# SQLAlchemy URL used by the backend
DATABASE_URL=postgresql+psycopg://fintwin:fintwin@localhost:5432/fintwin

# Demo account created by `flask seed`
DEMO_EMAIL=demo@fintwin.app
DEMO_PASSWORD=FinTwin@Demo2026

# AI Coach. "local" needs no key (deterministic answers built from your data).
# Set to "openai" or "gemini" and add the matching key to have an LLM explain the results;
# answers that quote numbers not found in your data are rejected automatically.
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
